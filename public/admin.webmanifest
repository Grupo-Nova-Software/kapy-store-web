{
  "name": "Kapy Store · Admin",
  "short_name": "Kapy Admin",
  "description": "Panel para gestionar productos, categorías y stock de Kapy Store.",
  "id": "/admin",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fafafa",
  "theme_color": "#0284c7",
  "lang": "es",
  "icons": [
    { "src": "/branding/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/branding/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/branding/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Nuevo producto", "url": "/admin/productos/nuevo" },
    { "name": "Alertas de stock", "url": "/admin/stock" }
  ]
}
